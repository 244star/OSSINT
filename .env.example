# Copy this file to .env and fill in the keys for the sources you want active.
# Every source degrades gracefully (returns no findings) if its key is missing,
# so you only need to fill in what you actually use.

# --- sources/dorks.py : SerperDorkSource ---
# Search-engine x-ray via serper.dev (generous free tier).
SERPER_API_KEY=

# --- sources/breaches.py : HibpSource ---
# Have I Been Pwned breach lookups. Free key from haveibeenpwned.com/API/Key.
HIBP_API_KEY=

# --- sources/telegram_phone.py : TelegramPhoneSource ---
# Requires a Telegram API app registered at my.telegram.org, plus `telethon`
# installed (pip install telethon) — it's imported lazily so the rest of the
# pipeline works without it. First run requires an interactive login (OTP).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- orchestrator.py : outbound proxy ---
# Optional. Routes all httpx requests through this proxy (e.g. Tor: socks5://127.0.0.1:9050).
# Can also be passed per-run with --proxy, which takes precedence over this.
OSINT_PROXY=

# --- cache.py ---
# Optional. Where cached source results are stored (default: .osint_cache.json).
OSINT_CACHE_PATH=
# Optional. Cache lifetime in seconds (default: 86400 = 24h). Also overridable
# per-source via that source's `cache_ttl` class attribute.
OSINT_CACHE_TTL=
# Optional. Set to 1 to disable the cache entirely (same as `--no-cache`).
OSINT_NO_CACHE=

# --- external CLI tools (not env vars, but required on PATH for these sources) ---
# sources/wrappers.py : MaigretSource  -> pip install maigret  (or pipx install maigret)
# sources/wrappers.py : SocialscanSource -> pip install socialscan
